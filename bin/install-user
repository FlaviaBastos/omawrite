#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
DESKTOP="$APP_DIR/omawrite.desktop"
TARGET="$BIN_DIR/omawrite"

status() {
  if [ -x "$TARGET" ]; then
    echo "Fork overlay is active."
    echo "  binary:  $TARGET"
    echo "  desktop: $DESKTOP"
    echo "  PATH hits: $(command -v omawrite)"
    echo "Packaged Omarchy binary remains at /usr/bin/omawrite."
    echo "Run bin/uninstall-user to go back to it."
  else
    echo "Fork overlay is off. $(command -v omawrite 2>/dev/null || echo omawrite) will be used."
  fi
}

if [ "${1:-}" = "--status" ]; then
  status
  exit 0
fi

"$ROOT/bin/build"

mkdir -p "$BIN_DIR" "$APP_DIR"
install -Dm755 "$ROOT/build/omawrite" "$TARGET"

cat > "$DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=Omawrite
GenericName=Markdown Writer
Comment=Omawrite with a live Markdown preview window (personal fork)
Exec="$TARGET" %f
TryExec=$TARGET
Icon=omawrite
Terminal=false
Categories=Office;WordProcessor;TextEditor;
MimeType=text/markdown;text/x-markdown;text/plain;
Keywords=markdown;write;notes;text;editor;
StartupWMClass=omawrite
EOF

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$APP_DIR" >/dev/null 2>&1 || true
fi

echo "Installed the fork over the user overlay (Omarchy's package is untouched):"
status
